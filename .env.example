# Local development defaults. Replace credentials outside local development.
API_KEY=dev-secret-key
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:15432/payments
RABBITMQ_URL=amqp://guest:guest@localhost:5673/
PAYMENT_GATEWAY_BACKEND=mock
OUTBOX_POLL_INTERVAL=0.5
OUTBOX_BATCH_SIZE=100
GATEWAY_MIN_DELAY=2
GATEWAY_MAX_DELAY=5
WEBHOOK_TIMEOUT=5
RETRY_BASE_DELAY=1
MAX_ATTEMPTS=3

# Host ports for Docker Compose.
API_PORT=18100
POSTGRES_PORT=15432
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
WEBHOOK_PORT=9001
